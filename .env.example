# ==============================================================================
# PROJETO: WALESKA — CONTAGEM PARA UM DIA ESPECIAL
# Variáveis de Ambiente (.env)
# ==============================================================================

# 1. Supabase - Frontend (Público)
# URL da instância Supabase (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co

# Chave anônima pública do Supabase (safe for browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase - Backend (Servidor / Vercel Functions)
# Mesma URL do Supabase para uso no backend Node.js / Vercel Function
SUPABASE_URL=https://xyzcompany.supabase.co

# Chave administrativa com privilégios de serviço (NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Cloudflare Turnstile (Proteção Anti-Spam e Bot)
# Chave do site para renderizar o widget Turnstile no navegador
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAx...

# Chave secreta de validação de token do Turnstile no backend
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# 4. Configuração Geral
# URL pública do site (para compartilhamento via WhatsApp e metatags)
SITE_URL=https://waleska-aniversario.vercel.app

# Porta local do servidor de desenvolvimento (Padrão: 3000)
PORT=3000
